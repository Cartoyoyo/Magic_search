@startuml magic_search

title Magic Search - Diagramme de classes (plugin QGIS)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "plugin_main" {
  class MagicSearch {
    - iface
    - search_widget : MagicSearchWidget
    - dock_widget : MagicSearchDockWidget
    - index_manager : IndexManager
    - ban_provider : BanProvider
    - osm_provider : OsmProvider
    - layer_provider : LayerProvider
    - ban_reverse_provider : BanReverseProvider
    - reverse_tool : ReverseGeocodeTool
    - street_view_tool : StreetViewTool
    - _config : dict
    - _visible : bool
    __
    + initGui()
    + unload()
    - _build_ui()
    - _toggle_visibility(checked)
    - _toggle_reverse_tool(checked)
    - _activate_street_view(service)
    - _on_map_tool_set(new_tool, old_tool)
    - _on_reverse_address_found(label)
    - _on_reverse_address_not_found(message)
    - _focus_search()
    - _open_config()
    - _apply_config()
    - _retranslate()
    - _force_reindex()
    - _on_layers_removed(layer_ids)
    - _on_project_loaded(doc)
    - _on_project_closed()
    - _save_config()
    - _load_config()
  }
}

package "__init__" {
  class classFactory << (F,orchid) function >>
}

package "core" {
  class IndexManager {
    + SYNC_NEVER, SYNC_SYNCING, SYNC_COMPLETE
    - _index : dict
    - _layers_config : dict
    - _queue : list
    - _timer : QTimer
    __
    + start_indexing()
    + stop()
    + search(query, max_per_field) : list
    + reindex_layer(layer_id)
    + remove_layer(layer_id)
    + set_config(layers_config, max_cache_mb)
    - _process_next()
    - _finalize()
    - _save_cache()
    - _load_cache(cache_path)
    __ signals __
    indexing_started()
    indexing_progress(str)
    indexing_finished()
    layer_ready(str)
    sync_state_changed(str)
  }

  class "geo_actions" as geo_actions << (M,lightblue) module >> {
    + color_for_layer(layer_id)
    + transform_point(iface, lon, lat)
    + zoom_to_point(iface, lon, lat, scale)
    + make_point_rubber(canvas, point, color)
    + zoom_to_features(iface, layer_id, fids)
    + make_features_rubber(iface, layer_id, fids, color, max_features)
    + clear_rubber(rubber_band)
  }

  class ReverseGeocodeTool {
    + MAX_DISTANCE_M = 25
    - _iface
    - _provider : BanReverseProvider
    - _rubber_band
    __
    + canvasReleaseEvent(event)
    + deactivate()
    - _on_result(data)
    __ signals __
    address_found(str)
    address_not_found(str)
  }

  class StreetViewTool {
    + SERVICE_LABELS : dict
    + SERVICE_URLS : dict
    - _iface
    - _service : str
    __
    + set_service(service)
    + canvasReleaseEvent(event)
    __
    (usage unique : ouvre l'URL du service\ndans le navigateur puis se desactive)
  }
}

package "providers" {
  class BanProvider {
    - _nam : QgsNetworkAccessManager
    - _timer : QTimer
    - _enabled : bool
    __
    + search(query)
    + cancel()
    + set_enabled(enabled)
    - _do_request()
    - _on_finished()
    __ signals __
    results_ready(list)
  }

  class OsmProvider {
    - _nam : QgsNetworkAccessManager
    - _timer : QTimer
    - _enabled : bool
    __
    + search(query)
    + cancel()
    + set_enabled(enabled)
    - _do_request()
    - _on_finished()
    __ signals __
    results_ready(list)
  }

  class LayerProvider {
    - _index_manager : IndexManager
    __
    + search(query, max_per_field)
    __ signals __
    results_ready(list)
  }

  class BanReverseProvider {
    - _nam : QgsNetworkAccessManager
    __
    + reverse(lon, lat)
    - _on_finished()
    __ signals __
    result_ready(dict)
  }
}

package "ui_common" {
  class StayOnTopEventFilter {
    - dialog
    - qgis_main_window
    - _reposition_cb
    __
    + eventFilter(watched, event)
    - _sync_visibility()
    - _maybe_raise()
  }
}

package "i18n" {
  class "i18n" as i18n_mod << (M,lightblue) module >> {
    + LANGS
    + set_lang(code)
    + current_lang()
    + tr(key, lang, **kwargs)
  }
}

package "search_widget (UI style 'maps')" {
  class MagicSearchWidget {
    - _iface
    - _index_manager : IndexManager
    - _ban_provider : BanProvider
    - _osm_provider : OsmProvider
    - _layer_provider : LayerProvider
    - _dropdown : DropdownWidget
    - _collapsed_btn : CollapsedButton
    - _btn_reverse : QPushButton
    - _btn_street : QToolButton
    - event_filter : StayOnTopEventFilter
    __
    + set_focus()
    + set_opacity(opacity)
    + retranslate()
    + reset_position()
    + set_reverse_active(active)
    + show_reverse_address(label)
    + show_reverse_not_found(message)
    + cleanup()
    - _on_text_changed(text)
    - _update_dropdown()
    - _on_result_clicked(data)
    - _collapse() / _expand()
    - _set_input_style(muted)
    __ signals __
    config_requested()
    sync_requested()
    reverse_toggled(bool)
    street_view_requested(str)
  }

  class DropdownWidget {
    - _widgets : list
    __
    + show_results(ban, osm, layer)
    + hide_results()
    __ signals __
    result_clicked(dict)
    result_hovered(dict)
    result_unhovered()
  }

  class CollapsedButton {
    __ signals __
    clicked()
    drag_started(QPoint)
    drag_moved(QPoint)
    drag_finished()
  }

  class ResultItem {
    - _data : dict
    __ signals __
    clicked(dict)
    hovered(dict)
    unhovered()
  }

  class ExpandItem {
    - _data : dict
    __ signals __
    clicked(dict)
  }

  class SearchIconWidget
}

package "dock_widget (UI style 'qt5')" {
  class MagicSearchDockWidget {
    - _iface
    - _index_manager : IndexManager
    - _ban_provider : BanProvider
    - _osm_provider : OsmProvider
    - _layer_provider : LayerProvider
    - event_filter : StayOnTopEventFilter
    - _widgets : list
    - _btn_reverse : QPushButton
    - _btn_street : QToolButton
    __
    + set_focus()
    + set_opacity(opacity)
    + retranslate()
    + set_reverse_active(active)
    + show_reverse_address(label)
    + show_reverse_not_found(message)
    + cleanup()
    - _on_text_changed(text)
    - _update_list()
    - _on_result_clicked(data)
    - _update_sync_style(state)
    - _set_input_style(muted)
    __ signals __
    config_requested()
    sync_requested()
    reverse_toggled(bool)
    street_view_requested(str)
  }

  class ResultItemDock {
    - _data : dict
    __ signals __
    clicked(dict)
    hovered(dict)
    unhovered()
  }

  class ExpandItemDock {
    - _data : dict
    __ signals __
    clicked(dict)
  }
}

package "config_dialog" {
  class ConfigDialog {
    - _config : dict
    - _layer_items : dict
    - _tree : QTreeWidget
    __
    + tr_(key)
    - _populate_layers_tree()
    - _build_config() : dict
    - _on_accept()
    - _on_reindex()
    - _show_about()
    __ signals __
    config_changed(dict)
    reindex_requested()
  }

  class AboutDialog {
    __
    (affiche version/auteur depuis metadata.txt,\nlien LinkedIn, licence GPLv3, GitHub)
  }
}

