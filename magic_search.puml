MagicSearch ..> i18n_mod : set_lang() / tr()

ResultItem ..> geo_actions : color_for_layer
ResultItemDock ..> geo_actions : color_for_layer
ExpandItem ..> geo_actions : color_for_layer
ExpandItemDock ..> geo_actions : color_for_layer

@enduml
