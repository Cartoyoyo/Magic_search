# Magic Search - architecture du plugin QGIS
# Rendu : d2 magic_search.d2 magic_search.svg
#         d2 --theme 200 --layout elk magic_search.d2 magic_search.svg

title: |md
  # Magic Search 2.0
  Architecture du plugin QGIS - un seul code pour QGIS 3.16 a 4.x
| {near: top-center}

direction: right

entry: __init__.py {
  classFactory: {
    shape: class
    +classFactory(iface): MagicSearch
  }
}

plugin: plugin_main.py {
  MagicSearch: {
    shape: class

    -iface
    -search_widget: MagicSearchWidget
    -dock_widget: MagicSearchDockWidget
    -index_manager: IndexManager
    -ban_provider: BanProvider
    -osm_provider: OsmProvider
    -layer_provider: LayerProvider
    -reverse_tool: ReverseGeocodeTool
    -street_view_tool: StreetViewTool
    -favorite_tool: FavoriteTool
    -_config: dict

    +initGui()
    +unload()
    -_build_ui()
    -_apply_config()
    -_open_config()
    -_sync_now()
    -_force_reindex()
    -_on_layers_added(layers)
    -_on_layers_removed(ids)
    -_load_config()
    -_save_config()
  }

  note: |md
    Preferences applicatives dans `QSettings`
    (globales), couches exclues et favoris
    dans le projet `.qgz`.
  |

  note_sync: |md
    **Rien ne s'indexe tout seul.**
    Au demarrage, a l'ouverture d'un projet
    ou a l'ajout d'une couche, le plugin se
    contente de recalculer l'etat de l'index.
    Seul le clic utilisateur declenche une passe.
  |
}

ui: ui/ {
  style.stroke-dash: 3

  MagicSearchWidget: {
    shape: class
    "barre flottante, style Maps"

    +set_favorites(items)
    +show_reverse_address(label)
    +retranslate()
  }

  MagicSearchDockWidget: {
    shape: class
    "panneau ancrable (style 'qt5')"

    +set_favorites(items)
    +show_reverse_address(label)
    +retranslate()
  }

  ConfigDialog: {
    shape: class
    +config_changed(dict)
    +reindex_requested()
  }

  ui_common: "ui/ui_common.py" {
    shape: class
    +StayOnTopEventFilter
    +SYNC_STYLES: "etat -> fond, texte, bordure, glyphe"
    +sync_button_style(state, radius): str
    +sync_button_glyph(state): str
  }
}

providers: providers/ {
  BanProvider: {
    shape: class
    "api-adresse.data.gouv.fr"
    +search(query)
    +results_ready(list)
  }
  OsmProvider: {
    shape: class
    "Nominatim"
    +search(query)
    +results_ready(list)
  }
  BanReverseProvider: {
    shape: class
    "geocodage inverse"
    +reverse(lon, lat)
  }
  LayerProvider: {
    shape: class
    +search(query, max_per_field)
    +results_ready(list)
  }
}

core: core/ {
  IndexManager: {
    shape: class

    -_index: "layer_id -> {name, key, fields}"
    -_by_key: "cle -> colonnes partagees"
    -_manifest: "layer_id -> {file, key, name}"
    -_pending: list
    -_queue: list
    -_skipped: "couches sans champ indexable"
    -_sync_state: "never | partial | syncing | complete"

    +start_indexing(force, purge)
    +search(query, max_per_field): list
    +refresh_sync_state(): str
    +missing_layers(): list
    +clear_index()
    +reindex_layer(layer_id)
    +remove_layer(layer_id)
    +stop()
    +sync_state_changed(str)
    -_triage_next()
    -_process_next()
    -_attach(layer_id, name, key, fields)
    -_save_key_cache(key, data)
    -_load_key_cache(key)
    -_prune_cache()
  }

  indexation: "Indexation (module)" {
    shape: class
    +_layer_fingerprint(layer): str
    +_index_key(fingerprint, exclus, all_types): str
    +_classify_fields(layer, exclus, all_types)
    +_is_integral(val): bool
    +_index_feature(feat, champs, index, watched)
    +_to_columnar(fields): dict
  }

  recherche: "Recherche (module)" {
    shape: class
    +normalize_text(text): str
    +_layer_name_score(nom, q): int
    +_search_column(col, q, n): "(hits, total)"
  }

  cache: "Cache v4 (module)" {
    shape: class
    +_pack_index(name, columns): bytes
    +_unpack_index(buf): "(name, columns)"
    +_compress(data): "lzma preset 3"
    +_decompress(data): bytes
  }

  outils: "Outils carte" {
    ReverseGeocodeTool: {shape: class}
    StreetViewTool: {shape: class}
    FavoriteTool: {shape: class}
  }

  geo_actions: {
    shape: class
    +zoom_to_features(iface, layer_id, fids)
    +make_features_rubber(iface, layer_id, fids)
    +zoom_to_point(iface, lon, lat)
  }

  coord_parser: {
    shape: class
    +parse_coordinates(text)
    +to_lonlat(coord)
  }

  qt_compat: "qt_compat (Qt5 / Qt6)" {
    shape: class
    +IS_QT6: bool
    +event_pos(event): QPoint
    +event_global_pos(event): QPoint
  }
}

colonne: |md
  ### Une colonne d'index

  Un champ indexe n'est plus un dictionnaire
  de valeurs mais quelques blocs compacts :

  - `hay` — valeurs normalisees, separees par `\x00`
  - `starts` — offset de chaque valeur (`array('i')`)
  - `orig` / `orig_starts` — valeurs d'origine, si differentes
  - `fids` / `fid_starts` — identifiants, a plat (`array('q')`)

  La recherche devient un `str.find()` a vitesse C,
  et la relecture du cache un `array.frombytes()`.
|

etats: |md
  ### Etat de synchronisation

  L'indexation etant manuelle, le bouton de la barre
  porte a lui seul l'etat de l'index. `refresh_sync_state()`
  compare les couches indexables du projet a `_index` :

  - **rouge** `never` — rien d'indexe, pastille pleine + glyphe d'alerte
  - **orange** `partial` — index incomplet (couche ajoutee, passe
    interrompue, exclusion levee), pastille pleine
  - **ambre** `syncing` — passe en cours
  - **vert** `complete` — tout est a jour, affichage discret

  Les couches examinees mais sans champ indexable sont retenues
  dans `_skipped` : sans cela elles resteraient comptees comme
  manquantes et le bouton ne repasserait jamais au vert.
|

portage: |md
  ### QGIS 3 et QGIS 4 dans le meme code

  QGIS 4 est bati sur Qt 6, ou deux choses changent :

  - les enums ne sont plus exposees a plat sur la classe
    (`Qt.CursorShape.ArrowCursor`, `QNetworkReply.NetworkError.NoError`,
    `QgsRubberBand.IconType.ICON_CIRCLE`) - le plugin n'ecrit plus
    que la forme scopee, valable sous Qt 5 comme sous Qt 6 ;
  - les evenements souris exposent `position()` / `globalPosition()`
    (QPointF) la ou Qt 5 offrait `pos()` / `globalPos()` (QPoint).

  Le second point est le seul qui demande du code : `core/qt_compat.py`
  interroge l'evenement au lieu de tester la version de Qt, et tout le
  reste du plugin (barre flottante, outils carte) passe par lui.

  `QAction` / `QShortcut` migrent de `QtWidgets` vers `QtGui` :
  `plugin_main.py` tente l'import Qt 6 puis retombe sur Qt 5.
|

i18n: i18n.py {
  shape: class
  +tr(key, lang, **kwargs)
  +set_lang(code)
  +current_lang()
}

# --- relations ---
entry.classFactory -> plugin.MagicSearch: instancie

plugin.MagicSearch -> ui.MagicSearchWidget: "style = maps"
plugin.MagicSearch -> ui.MagicSearchDockWidget: "style = qt5"
plugin.MagicSearch -> ui.ConfigDialog: ouvre
plugin.MagicSearch -> core.IndexManager: "refresh_sync_state() au demarrage"
plugin.MagicSearch -> core.IndexManager: "start_indexing() sur clic utilisateur"
plugin.MagicSearch -> core.outils

ui.MagicSearchWidget -> providers.BanProvider: search()
ui.MagicSearchWidget -> providers.OsmProvider: search()
ui.MagicSearchWidget -> providers.LayerProvider: search()
ui.MagicSearchWidget -> core.coord_parser
ui.MagicSearchWidget -> core.geo_actions: "zoom / surbrillance"
ui.MagicSearchDockWidget -> providers.LayerProvider: search()
ui.ConfigDialog -> plugin.MagicSearch: config_changed
ui.MagicSearchWidget -> plugin.MagicSearch: sync_requested
ui.MagicSearchDockWidget -> plugin.MagicSearch: sync_requested
core.IndexManager -> ui.ui_common: "sync_state_changed -> pastille"
ui.ui_common -> etats: peint

providers.LayerProvider -> core.IndexManager: search()
core.outils.ReverseGeocodeTool -> providers.BanReverseProvider

core.IndexManager -> core.indexation: "parcours par lots"
core.IndexManager -> core.recherche
core.IndexManager -> core.cache: "<cle>.idx"
core.indexation -> colonne: produit
colonne -> core.recherche: balaye
colonne -> core.cache: serialise

ui -> i18n: tr()
plugin -> i18n: set_lang()

ui.MagicSearchWidget -> core.qt_compat: "deplacement / redimensionnement"
core.outils -> core.qt_compat: "clic sur la carte"
core.qt_compat -> portage: explique
